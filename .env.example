# demo: VTEX y paquetería en memoria (no necesitas nada más)
# live: llama a la API real del OMS de VTEX con las credenciales de abajo
MODE=demo
PORT=3000

# El mismo valor que configures en los headers del hook en VTEX
HOOK_SECRET=cambia-este-secreto

# Reintentos: espera 1s, 2s, 4s, 8s... hasta MAX_ATTEMPTS
MAX_ATTEMPTS=5
RETRY_BASE_MS=1000

# Qué tan seguido "se cae" la paquetería de mentira (0 a 1)
CARRIER_FAILURE_RATE=0.3

# Solo para MODE=live
VTEX_ACCOUNT=
VTEX_ENVIRONMENT=vtexcommercestable
VTEX_APP_KEY=
VTEX_APP_TOKEN=
